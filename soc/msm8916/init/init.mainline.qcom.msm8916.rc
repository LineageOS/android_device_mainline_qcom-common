# Graphics (Mesa)
on property:ro.hardware.egl=mesa && property:vendor.qcom.soc.machine=MSM8916
    setprop ro.opengles.version 196608

# Modem
on property:vendor.qcom.soc.machine=MSM8916
    setprop ro.vendor.qcom.soc.enable_modem_services 1
