soong_namespace {
}

install_symlink {
    name: "vendor_etc_hexagonrpcd-root_dsp_symlink",
    vendor: true,
    installed_location: "etc/hexagonrpcd-root/dsp",
    symlink_target: "/vendor/dsp",
}

install_symlink {
    name: "vendor_etc_hexagonrpcd-root_sensors_registry_symlink",
    vendor: true,
    installed_location: "etc/hexagonrpcd-root/sensors/registry",
    symlink_target: "/mnt/vendor/persist/sensors/registry/registry",
}

mkdir {
    name: "mainline_qcom-common_vendor_dsp_mountpoint",
    dir: "dsp",
    vendor: true,
}

mkdir {
    name: "mainline_qcom-common_vendor_firmware_gen_mountpoint",
    dir: "firmware_gen",
    vendor: true,
}

mkdir {
    name: "mainline_qcom-common_vendor_firmware_mnt_mountpoint",
    dir: "firmware_mnt",
    vendor: true,
}

phony {
    name: "hexagonrpcd_common_phony",
    required: [
        "hexagonrpcd",
        "vendor_etc_hexagonrpcd-root_dsp_symlink",
        "vendor_etc_hexagonrpcd-root_sensors_registry_symlink",
    ],
}

phony {
    name: "hexagonrpcd_adsp_rootpd_phony",
    required: [
        "hexagonrpcd_common_phony",
        "hexagonrpcd-adsp-rootpd.rc",
    ],
}

phony {
    name: "hexagonrpcd_adsp_sensorspd_phony",
    required: [
        "hexagonrpcd_common_phony",
        "hexagonrpcd-adsp-sensorspd.rc",
    ],
}

phony {
    name: "hexagonrpcd_sdsp_phony",
    required: [
        "hexagonrpcd_common_phony",
        "hexagonrpcd-sdsp.rc",
    ],
}
