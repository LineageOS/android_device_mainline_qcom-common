soong_namespace {
}

install_symlink {
    name: "vendor_etc_hexagonrpcd-root_sensors_registry_registry_symlink",
    vendor: true,
    installed_location: "etc/hexagonrpcd-root/sensors/registry/registry",
    symlink_target: "/mnt/vendor/persist/sensors/registry/registry",
}

mkdir {
    name: "vendor_etc_hexagonrpcd-root_dsp_mountpoint",
    dir: "etc/hexagonrpcd-root/dsp",
    vendor: true,
}

mkdir {
    name: "vendor_firmware_gen_mountpoint",
    dir: "firmware_gen",
    vendor: true,
}
