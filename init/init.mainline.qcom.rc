import /vendor/etc/init/hw/init.mainline.rc
import /vendor/etc/init/hw/init.mainline.qcom.${ro.vendor.qcom.soc.family}.rc
import /vendor/etc/init/hw/init.qcom.usb.rc

# /dev/block/bootdevice symlink
on init
    symlink /dev/block/platform/${ro.boot.boot_devices} /dev/block/bootdevice

# init.mainline.qcom.sh service
service vendor.init-mainline-qcom-sh /vendor/bin/init.mainline.qcom.sh
    user root
    group root
    oneshot
    disabled

on init
    start vendor.init-mainline-qcom-sh

# Modem
on boot && property:ro.vendor.qcom.soc.enable_modem_services=1
    exec - root -- /vendor/bin/qrtr-cfg 1

    start vendor.pd-mapper

    mkdir /data/vendor/tmp
    mkdir /data/vendor/tmp/tqftpserv
    mkdir /data/vendor/readonly
    mkdir /data/vendor/readonly/firmware
    mkdir /data/vendor/readonly/firmware/image
    mkdir /data/vendor/readwrite

    write /sys/class/firmware/timeout 1

    start vendor.tqftpserv
    start vendor.rmtfs

on shutdown
    stop vendor.rmtfs

# Persist
on post-fs
    mkdir /mnt/vendor/persist-overlayfs-upperdir
    mkdir /mnt/vendor/persist-overlayfs-workdir
    mount overlay overlay /mnt/vendor/persist rw lowerdir=/mnt/vendor/persist,upperdir=/mnt/vendor/persist-overlayfs-upperdir,workdir=/mnt/vendor/persist-overlayfs-workdir

# Remoteproc
on property:vendor.remoteproc.trigger_start=*
    exec u:r:vendor_start_remoteproc:s0 -- /vendor/bin/sh /vendor/bin/init.mainline.qcom.start_remoteproc.sh ${vendor.remoteproc.trigger_start}

on start_all_remoteproc
    trigger firmware_mounts_complete
    exec u:r:vendor_start_remoteproc:s0 -- /vendor/bin/sh /vendor/bin/init.mainline.qcom.start_remoteproc.sh

# Set SoC properties
on property:vendor.qcom.soc.machine=*
    setprop ro.soc.model ${vendor.qcom.soc.machine}

# USB
on early-init && property:sys.usb.controller=*
    setprop vendor.usb.controller ${sys.usb.controller}
